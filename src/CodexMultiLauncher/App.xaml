<Application x:Class="CodexMultiLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WorkspaceBackground" Color="#FFF3F6FB" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF273C9B" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF1F3182" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#FF182666" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF1677E8" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#FFEAF2FF" />
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#FFF1F6FF" />
    <SolidColorBrush x:Key="AccountIconBackgroundBrush" Color="#FFE3EEFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFDCE4EF" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF17223B" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF5B6980" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#FFE6EAF0" />
    <SolidColorBrush x:Key="InformationBrush" Color="#FF1677E8" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF0A9B79" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFC23B47" />
    <Style TargetType="{x:Type Control}"><Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" /></Style>
    <Style TargetType="{x:Type TextBlock}"><Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" /></Style>
  </Application.Resources>
</Application>
